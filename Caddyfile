vynia.app {
    # WebSocket relay — explicit upgrade matcher, must come before all other routes
    @ws {
        path /ws
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @ws backend:3001 {
        transport http {
            versions 1.1
        }
    }

    # REST API (NestJS, prefix /api)
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Frontend static app
    handle {
        reverse_proxy frontend:80
    }

    encode gzip
}
