vynia.app {
    # WebSocket relay — path-only match, works with both HTTP/1.1 and HTTP/2 (Cloudflare)
    handle /ws {
        reverse_proxy backend:3001 {
            transport http {
                versions 1.1
            }
        }
    }

    # REST API (NestJS, prefix /api)
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Frontend static app
    handle {
        reverse_proxy frontend:80
    }

    encode gzip
}
