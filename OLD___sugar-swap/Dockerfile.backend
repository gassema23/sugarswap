FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

# Copy server source + its tsconfig
COPY server/ ./server/
COPY tsconfig.json ./

# Install tsx to run TypeScript directly (already in devDeps, re-install for prod)
RUN npm install tsx

EXPOSE 3001

CMD ["npx", "tsx", "server/index.ts"]
