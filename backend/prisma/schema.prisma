generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  socialId      String
  provider      String        // "google" | "facebook"
  name          String
  avatar        String?
  level         Int           @default(1)
  experience    Int           @default(0)
  totalMatches  Int           @default(0)
  totalPoints   Int           @default(0)
  unlockedSkins String[]      @default([])
  badges        Badge[]
  matchPlayers  MatchPlayer[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([socialId, provider])
  @@index([totalMatches])
}

// ─── Badge ────────────────────────────────────────────────────────────────────

model Badge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BadgeType
  awardedAt DateTime  @default(now())

  @@unique([userId, type])
  @@index([userId])
}

// ─── Match ────────────────────────────────────────────────────────────────────

model Match {
  id        String        @id @default(cuid())
  mode      MatchMode
  startedAt DateTime
  endedAt   DateTime
  players   MatchPlayer[]
  createdAt DateTime      @default(now())
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   String? // null = guest or AI
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name     String  // display name at time of game
  points   Int
  isAi     Boolean @default(false)
  isWinner Boolean @default(false)

  @@index([matchId])
  @@index([userId])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MatchMode {
  VS_AI
  ONLINE
}

enum BadgeType {
  FIRST_WIN        // Première victoire
  VETERAN          // 10 parties jouées
  GRAND_MASTER     // 50 parties jouées
  SHARP_MIND       // Score ≤ 10 points en une partie
  PERFECTIONIST    // Score 0 points en une partie
  LEVEL_5          // Atteint niveau 5
  LEVEL_10         // Atteint niveau 10
  LEVEL_15         // Atteint niveau 15
  SOCIAL_BUTTERFLY // A joué en ligne
}
